// [01] Team signing stays a local choice. The shared app identity and group below must match the Apple team's
// registered values.
TEAM_ID =
PRODUCT_NAME = digitalfootprintexplorer
DFE_APP_BUNDLE_IDENTIFIER = ch.zhaw.digitalfootprintexplorer.ios
PRODUCT_BUNDLE_IDENTIFIER = $(DFE_APP_BUNDLE_IDENTIFIER)
DFE_APP_GROUP_IDENTIFIER = group.$(DFE_APP_BUNDLE_IDENTIFIER)
CODE_SIGN_ENTITLEMENTS = Configuration/App.entitlements
// [02] Keep version and build values together; a release still needs an unused build number in App Store
// Connect.
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0
// [03] Set approved public privacy and support pages before release. A blank privacy URL is a release task,
// not a working policy link.
DFE_PRIVACY_POLICY_URL =
DFE_SUPPORT_URL = https:/$()/zhaw-init-softwareengineering.github.io/digital-footprint-explorer/
// [04] Both apps use the model at the repository root, built for the selected device or simulator.
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)
OTHER_LDFLAGS = $(inherited) -framework Shared -lsqlite3
// [05] Personal signing choices can override this shared setup locally without entering the repository.
#include? "Local.xcconfig"
