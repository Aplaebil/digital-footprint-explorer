-- [01] Keep one total per day together with its contributions and the comparison used for that garden. Values
-- are saved in kilograms of CO2e.
CREATE TABLE DailyEmission (
    date           TEXT NOT NULL PRIMARY KEY,
    total_kg       REAL NOT NULL,
    app_usage_kg   REAL NOT NULL DEFAULT 0,
    display_kg     REAL NOT NULL DEFAULT 0,
    background_kg  REAL NOT NULL DEFAULT 0,
    calculated_at  TEXT NOT NULL DEFAULT '',
    garden_state   TEXT NOT NULL DEFAULT 'STABLE',
    baseline_kg    REAL NOT NULL DEFAULT 0
);

-- [02] Each category detail stays linked to its day, so it cannot outlive a deleted daily result.
CREATE TABLE DailyEmissionCategory (
    date      TEXT NOT NULL REFERENCES DailyEmission(date) ON DELETE CASCADE,
    category  TEXT NOT NULL,
    total_kg  REAL NOT NULL,
    PRIMARY KEY (date, category)
);

-- [03] The first saved result for a date stays in place. A repeated daily job does not replace that history
-- entry.
insert:
INSERT OR IGNORE INTO DailyEmission(date, total_kg, app_usage_kg, display_kg, background_kg, calculated_at, garden_state, baseline_kg)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- [04] The day and category pair prevents a repeated save from adding the same category twice.
insertCategory:
INSERT OR IGNORE INTO DailyEmissionCategory(date, category, total_kg)
VALUES (?, ?, ?);

-- [05] History needs the days in calendar order, while the latest-result views below start with the newest
-- day.
selectAll:
SELECT * FROM DailyEmission ORDER BY date ASC;

selectLatest:
SELECT * FROM DailyEmission ORDER BY date DESC LIMIT 1;

-- [06] The garden comparison uses the latest seven saved days; this query does not delete older history.
selectLatest7:
SELECT * FROM DailyEmission ORDER BY date DESC LIMIT 7;

-- [07] Daily details should read only the categories linked to the day the person opened.
selectCategoriesByDate:
SELECT * FROM DailyEmissionCategory WHERE date = ?;

-- [08] The comparison needs to know whether any earlier days exist before choosing its starting behaviour.
count:
SELECT COUNT(*) FROM DailyEmission;
