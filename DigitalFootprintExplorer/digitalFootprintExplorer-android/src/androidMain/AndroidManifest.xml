<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- [01] This is a protected Android permission. Declaring it does not grant network-stat access to an
         ordinary install. -->
    <uses-permission android:name="android.permission.READ_NETWORK_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- [02] The user must allow usage history in Android Settings before the app can use that source. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- [03] Android uses different Bluetooth permissions on older and newer versions; the app needs access to
         read the switch state. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- [04] The visible tracking service records screen and switch periods between visits, within Android's
         service restrictions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- [05] After a restart, the app can request its tracking service and daily schedule again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- [06] Daily garden messages need their own notification permission on supported Android versions. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- [07] Limit the app lookup to launchable activities, which are the starting list for the Android category
         calculation. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
            android:name=".DFEApplication"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
                android:exported="true"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>


        <!-- [08] The tracking service belongs to this app; other apps cannot directly start it through this
             declaration. -->
        <service
            android:name=".servicelayerplatform.service.TrackingService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />


        <receiver
            android:name=".worker.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- [09] Android sends widget update events here, and the provider file describes its Home Screen size
             and preview. -->
        <receiver
            android:name=".widget.GardenWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/garden_widget_info" />
        </receiver>

    </application>

</manifest>
